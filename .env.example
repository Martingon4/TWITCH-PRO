PORT=4173
HOST=127.0.0.1

# OpenAI API: si se deja vacío, la app usa salas y comentarios de respaldo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twitch Developer Console: usa el Client ID de tu aplicación registrada.
# La app usa Device Code Grant y mantiene los tokens solo en memoria.
TWITCH_CLIENT_ID=

# Protege el panel cuando Nexo se publica en internet.
# En desarrollo local pueden dejarse vacíos; en NODE_ENV=production son obligatorios.
APP_PASSWORD=
APP_SESSION_SECRET=
OVERLAY_TOKEN=
