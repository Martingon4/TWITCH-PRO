PORT=4173
HOST=127.0.0.1

# OpenAI API: si se deja vacío, la app usa salas y comentarios de respaldo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twitch Developer Console: usa el Client ID de tu aplicación registrada.
# El flujo de dispositivo permite que cada streamer autorice su propio canal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# PostgreSQL compartido para separar y persistir cuentas, salas y chat.
# Localmente puede quedar vacío (modo memoria); es obligatorio en producción.
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

# Protege el panel cuando Nexo se publica en internet.
# En desarrollo local pueden dejarse vacíos; en NODE_ENV=production son obligatorios.
APP_PASSWORD=
APP_SESSION_SECRET=
