PORT=4173
HOST=127.0.0.1

# Generación de escenarios: agrega solo la clave del proveedor que quieras usar.
# Gemini es el proveedor inicial al elegir "IA"; sin claves se usan plantillas gratis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI también está disponible como proveedor alternativo para generar escenarios.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Twitch Developer Console: usa el Client ID de tu aplicación registrada.
# El flujo de dispositivo permite que cada streamer autorice su propio canal.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# PostgreSQL compartido para separar y persistir cuentas, salas y chat.
# Localmente puede quedar vacío (modo memoria); es obligatorio en producción.
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

# Firma sesiones privadas iniciadas con Twitch. Render la genera automáticamente.
# En producción es obligatoria; en desarrollo local se usa una clave temporal.
APP_SESSION_SECRET=
